# ─── Producción con Docker (compose.prod.yaml) ───────────────────────────────
# Copiar a .env en el servidor y completar los valores marcados con <...>.
# Nunca subir el .env real al repositorio.

APP_NAME=Rifax
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=<generar>
APP_URL=https://megaeliteoficial.com
ASSET_URL=https://megaeliteoficial.com
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# Dominio que atiende Caddy (HTTPS automático). Debe apuntar por DNS a este servidor.
APP_DOMAIN="megaeliteoficial.com, www.megaeliteoficial.com"
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Base de datos (contenedor "postgres")
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rifax
DB_USERNAME=rifax
# Generar con: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
DB_PASSWORD=<generar>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.megaeliteoficial.com

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_HOST=<smtp>
MAIL_PORT=587
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<clave>
MAIL_FROM_ADDRESS="no-reply@megaeliteoficial.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=twilio
WHATSAPP_SEND_ENABLED=true
WHATSAPP_TIMEOUT_SECONDS=10
WHATSAPP_RETRY_ATTEMPTS=3
WHATSAPP_RETRY_BACKOFF_SECONDS=60
WHATSAPP_WEBHOOK_RATE_LIMIT_MAX_ATTEMPTS=120
WHATSAPP_WEBHOOK_RATE_LIMIT_DECAY_SECONDS=60
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=es_CO

# Twilio. En la consola de Twilio, webhook entrante del número:
#   https://megaeliteoficial.com/api/webhooks/twilio/whatsapp   (POST)
TWILIO_ACCOUNT_SID=<ACxxxxxxxx>
TWILIO_AUTH_TOKEN=<token>
TWILIO_WHATSAPP_FROM=<+57XXXXXXXXXX>
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_CONTENT_SID_MAP={}
TWILIO_CONTENT_LANGUAGE=es

# Meta (solo si WHATSAPP_PROVIDER=meta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Atención humana: el bot retoma un chat sin respuesta de agente tras estos minutos.
HANDOFF_IDLE_RELEASE_MINUTES=720
PAYMENT_REVIEW_TIMEOUT_HOURS=48
